# AfterDark web app — environment template (copy to .env.local; never commit real values)

# ── Required ──────────────────────────────────────────────────────────────────
# Neon Postgres. Use the POOLED connection string for serverless route handlers
# (CLAUDE.md §6.3). Format: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# better-auth secret — signs sessions AND encrypts 2FA TOTP secrets/backup
# codes at rest (twoFactor plugin). ⚠ Rotating it invalidates every 2FA
# enrollment. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Recommended ───────────────────────────────────────────────────────────────
# Canonical URL (also a trusted origin for CSRF checks).
BETTER_AUTH_URL=http://localhost:4000

# (AUTH_SECRET_ENCRYPTION_KEY is no longer used — the hand-rolled 2FA it
# encrypted was replaced by the better-auth twoFactor plugin in migration
# 0005. Harmless if still set.)

# ── Optional: social sign-in (self-activates when both values are present) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ── Optional: create.xyz platform embedding (builder iframe + CSP origins) ────
# OFF by default since S1 (embed lockdown, Backlog #16): the origins below are
# ignored — frame-ancestors stays 'self' and cookies stay SameSite=Lax —
# unless CREATE_BUILDER_EMBED=1 opts the builder embed back in.
CREATE_BUILDER_EMBED=
NEXT_PUBLIC_CREATE_BASE_URL=
NEXT_PUBLIC_CREATE_HOST=
NEXT_PUBLIC_PROJECT_GROUP_ID=
NEXT_PUBLIC_CREATE_ENV=

# ── Optional: mobile auth bridge ──────────────────────────────────────────────
EXPO_PUBLIC_PROXY_BASE_URL=

# ── Optional: error tracking (Sentry — no-ops when unset) ─────────────────────
# Server + edge errors. All events pass the PII scrubber (src/lib/sentry-scrub.ts).
SENTRY_DSN=
# Browser errors. Its origin is auto-added to the CSP connect-src.
NEXT_PUBLIC_SENTRY_DSN=

# ── Optional: payments (Stripe Connect, P8 — key-gated) ───────────────────────
# Without these the marketplace still works end-to-end: payouts are recorded in
# the ledger and released on schedule, just without real money movement.
# /api/stripe/* returns 503 until STRIPE_SECRET_KEY is set. Use TEST keys (sk_test_…).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from the Stripe dashboard or `stripe listen`.
# Endpoint to register: POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── Optional: media storage (Vercel Blob, P4) ─────────────────────────────────
# When set, processed profile/portfolio images upload to Blob and the DB stores
# URLs. When unset, images are still EXIF-stripped + resized but stored inline
# as data URLs (fine for dev, bloats rows in prod).
BLOB_READ_WRITE_TOKEN=

# ── Optional: scheduled jobs ──────────────────────────────────────────────────
# Bearer token that lets a cron service call POST /api/payouts/release
# (escrow release 24h after checkout). Admins can also trigger it by session.
# Generate: openssl rand -hex 32. Vercel Cron sends it automatically when set
# (see vercel.json "crons" + CRON_SECRET convention). Also authenticates the
# daily retention purge (POST /api/retention/purge, S2/G7).
CRON_SECRET=

# ── Optional: rate limiting (S1) ──────────────────────────────────────────────
# Backend for getRateLimiter: auto (unset) = shared Postgres store in
# production, in-memory in dev/test. Force with `memory` or `postgres`.
RATE_LIMIT_STORE=

# ── Preview accounts (never in git — TESTING.md §2) ───────────────────────────
# Secret the shared preview-account passwords are derived from
# (yarn db:preview-accounts). Per-environment; rotate it to rotate every
# preview password. Generate: openssl rand -hex 32
PREVIEW_ACCOUNTS_SECRET=
