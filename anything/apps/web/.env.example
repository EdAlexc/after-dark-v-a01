# AfterDark web app — environment template (copy to .env.local; never commit real values)

# ── Required ──────────────────────────────────────────────────────────────────
# Neon Postgres. Use the POOLED connection string for serverless route handlers
# (CLAUDE.md §6.3). Format: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# Encrypts TOTP 2FA secrets at rest (AES-256-GCM via SecretBox).
# Generate: openssl rand -base64 32
# Without it, 2FA enrollment fails closed by design.
AUTH_SECRET_ENCRYPTION_KEY=

# ── Recommended ───────────────────────────────────────────────────────────────
# better-auth secret + canonical URL (also a trusted origin for CSRF checks).
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# ── Optional: social sign-in (self-activates when both values are present) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ── Optional: create.xyz platform embedding (builder iframe + CSP origins) ────
NEXT_PUBLIC_CREATE_BASE_URL=
NEXT_PUBLIC_CREATE_HOST=
NEXT_PUBLIC_PROJECT_GROUP_ID=
NEXT_PUBLIC_CREATE_ENV=

# ── Optional: mobile auth bridge ──────────────────────────────────────────────
EXPO_PUBLIC_PROXY_BASE_URL=

# ── Optional: explore mode (demo/QA aid) ─────────────────────────────────────
# Set to 1 to browse /dashboard/* and /onboarding without signing in. Most
# dashboards render mock data, so the UI is fully walkable.
# Ignored when VERCEL_ENV=production, and it only lifts the middleware cookie
# check — route handlers still enforce authZ, so API-backed screens (profile
# editors, settings) still 401. Leave unset for normal development.
DISABLE_AUTH_GATE=
